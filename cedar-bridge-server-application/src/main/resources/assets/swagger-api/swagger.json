  "components" : {
    "schemas" : {
      "AuthorityDetails" : {
        "type" : "object",
        "additionalProperties" : true,
        "description" : "What one authority holds for one identifier. Only `found` and `requestedId` are added by\nCEDAR; the rest of the object is the authority's own, and the keys below are the ones every\nauthority sets when it resolves an identifier. ORCID and ROR also pass the registry's whole\nrecord through under `rawResponse`, and its errors under `errors`.\n",
        "properties" : {
          "details" : {
            "type" : "string",
            "description" : "A line of supporting detail, where the authority composes one."
          },
          "errors" : {
            "type" : "array",
            "description" : "What the registry said went wrong, one message per entry.",
            "items" : {
              "type" : "string"
            }
          },
          "found" : {
            "type" : "boolean",
            "description" : "Whether the identifier resolved."
          },
          "id" : {
            "type" : "string",
            "format" : "uri",
            "description" : "The entry's IRI, as the authority spells it.",
            "nullable" : true
          },
          "name" : {
            "type" : "string",
