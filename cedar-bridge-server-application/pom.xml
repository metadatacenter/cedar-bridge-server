<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.metadatacenter</groupId>
    <artifactId>cedar-bridge-server</artifactId>
    <version>2.9.4</version>
  </parent>

  <groupId>org.metadatacenter</groupId>
  <artifactId>cedar-bridge-server-application</artifactId>
  <packaging>jar</packaging>

  <name>CEDAR Bridge Server Dropwizard Application</name>

  <properties>
    <!-- Opt in to the cedar-shade execution managed in cedar-parent. -->
    <cedar.shade.phase>package</cedar.shade.phase>
    <cedar.shade.main.class>org.metadatacenter.cedar.bridge.BridgeServerApplication</cedar.shade.main.class>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-bridge-server-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-server-rest-library</artifactId>
    </dependency>

    <dependency>
      <groupId>org.apache.httpcomponents.client5</groupId>
      <artifactId>httpclient5</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-config-library</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-server-utils-core-library</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-template-operations-library</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-server-globals-library</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-server-utils-dropwizard-library</artifactId>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-logging-operations-library</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- CedarInstanceParser reads the DOI prefix and the OpenView base through deep config chains;
         the tests stub those rather than build a whole CedarConfig. -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.metadatacenter</groupId>
      <artifactId>cedar-test-support-library</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
    </dependency>

    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
    </dependency>

    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <dependency>
      <groupId>io.dropwizard</groupId>
      <artifactId>dropwizard-testing</artifactId>
    </dependency>

    <dependency>
      <groupId>io.dropwizard</groupId>
      <artifactId>dropwizard-client</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- OpenAPI annotations on the resource classes. Version managed in cedar-parent. -->
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations-jakarta</artifactId>
    </dependency>

  </dependencies>

  <build>

    <plugins>

      <!--
        DataCiteResourceTest (tagged "datacite") calls the live DataCite REST API to mint and read
        DOIs; it needs network access and DataCite credentials, so it is excluded from the default
        build. Run it with -DexcludedGroups= to clear the exclusion when DataCite is reachable.
        CedarConfigRepoTest is untagged and always runs.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludedGroups>datacite</excludedGroups>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
      </plugin>

      <!--
        Filters the base OpenAPI document (src/main/swagger/openapi-base.yaml) so ${project.version}
        is stamped into info.version, then writes it to target/ for the swagger-maven-plugin to read.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>filter-openapi-base</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/generated-swagger</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/src/main/swagger</directory>
                  <includes>
                    <include>openapi-base.yaml</include>
                  </includes>
                  <filtering>true</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Generates the OpenAPI 3.0 spec from the JAX-RS (jakarta.ws.rs) resource annotations into
        src/main/resources/assets/swagger-api/ as swagger.json + swagger.yaml (committed; Maven
        copies it onto the classpath that the Dropwizard AssetsBundle serves, and its presence is
        what makes the server serve and advertise documentation at all). sortOutput keeps the spec
        byte-stable. Info and the api_key security scheme come from the filtered openapi-base.yaml.
      -->
      <plugin>
        <groupId>io.swagger.core.v3</groupId>
        <artifactId>swagger-maven-plugin-jakarta</artifactId>
        <configuration>
          <outputPath>${project.basedir}/src/main/resources/assets/swagger-api</outputPath>
          <outputFileName>swagger</outputFileName>
          <outputFormat>JSONANDYAML</outputFormat>
          <prettyPrint>true</prettyPrint>
          <sortOutput>true</sortOutput>
          <resourcePackages>
            <package>org.metadatacenter.cedar.bridge.resources</package>
          </resourcePackages>
          <openapiFilePath>${project.build.directory}/generated-swagger/openapi-base.yaml</openapiFilePath>
        </configuration>
        <executions>
          <execution>
            <phase>prepare-package</phase>
            <goals>
              <goal>resolve</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

    </plugins>

  </build>

</project>
